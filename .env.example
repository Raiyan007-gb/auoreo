AUOREO_ENVIRONMENT_MODAL_IMAGE=
# default https://app.daytona.io/api  [home]
AUOREO_ENVIRONMENT_DAYTONA_API_URL=
# default unset  [home]
AUOREO_ENVIRONMENT_DAYTONA_SNAPSHOT=
# default 3600  [home]
AUOREO_ENVIRONMENT_SANDBOX_TIMEOUT_S=
# {"url":"ws://host:port","token_secret":"exec_token"} for an exec-server
# JSON object; settings.json key `environment_remote`  [home]
AUOREO_ENVIRONMENT_REMOTE=
# named peer instances for the signed instance bridge · default {} (JSON)  [home]
AUOREO_BRIDGES=
# CLI: talk to this running server instead of working in-process  [home]
AUOREO_URL=
# `auoreo exec-server` bearer token (prefer --token-secret)  [home]
AUOREO_EXEC_TOKEN=

# -------------------------------------------------------------------------- observability
# log format text | json, level · JSON object; settings.json key `logging`  [home]
AUOREO_LOGGING=
# off | local | otlp · default off  [home]
AUOREO_OTEL_MODE=
# include prompts/outputs in spans (off: metadata only) · default false  [home]
AUOREO_OTEL_CAPTURE_CONTENT=
# OTLP collector for otel_mode=otlp, http://localhost:4318  [home]
OTEL_EXPORTER_OTLP_ENDPOINT=
# traces-only OTLP endpoint (overrides the one above)  [home]
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTLP auth headers, key=value,key2=value2
OTEL_EXPORTER_OTLP_HEADERS=
# trace sampling ratio 0..1
OTEL_TRACES_SAMPLER_ARG=
# Sentry DSN (needs the sentry extra) · default unset  [home]
AUOREO_SENTRY_DSN=
# full | errors_only | off · default errors_only  [home]
AUOREO_SENTRY_SHARE=
# write a Perfetto/Chrome trace JSON here · default unset  [home]
AUOREO_TRACE_FILE=

# -------------------------------------------------------------------------------- updates
# stable | beta | dev · default stable  [home]
AUOREO_UPDATE_CHANNEL=
# signed update manifest URL template
# default https://github.com/Raiyan007-gb/auoreo/releases/download/updates/manifest-{channel}.json  [home]
AUOREO_UPDATE_URL=
# extra ed25519 public keys trusted for update manifests · default [] (JSON)  [home]
AUOREO_UPDATE_PUBKEYS=

# ------------------------------------------ developer and CI (leave blank for normal use)
# set to 1 to skip network probes in doctor and backends  [home]
AUOREO_OFFLINE=
# override the code hash reported by /api/health  [home]
AUOREO_CODE_SHA=
# set to 1 to build a wheel without web/dist  [home]
AUOREO_ALLOW_NO_WEB_DIST=
# release CI: ed25519 private key (PEM) that signs update manifests
UPDATE_SIGNING_KEY=
# release CI: ed25519 private key (PEM) that signs bundled plugins
PLUGIN_SIGNING_KEY=
