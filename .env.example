# AUOREO — every environment variable AUOREO reads. Copy to `~/.auoreo/.env` (recommended) or a
# project `.env`, then fill in only what you use: a blank value is ignored (the built-in default
# applies), and a variable already set in the real environment always wins.
#
# Where a variable may live:
#   (no tag)    anywhere: a project `.env`, `~/.auoreo/.env`, or the real environment
#   [home]      `~/.auoreo/.env` or the real environment. A PROJECT `.env` is repository-controlled,
#               so it may only set provider keys and AUOREO_MODEL / SMALL_MODEL / EMBED_MODEL /
#               EMBED_DIMS / AGENT / WORKFLOW / GATEWAY / PORT; anything else (and any *_API_BASE,
#               *_URL, *_HOST, *_ENDPOINT, proxy, PATH-like name) is ignored there with a warning.
#   [env-only]  security knobs: read ONLY from the real process environment (`export ...`); both
#               `.env` files ignore them with a warning, so a checked-out repo can never set them.
#
# Every AUOREO_* below is also a `settings.json` key (`~/.auoreo/settings.json`, same name in
# lower case without the prefix); the environment wins over settings.json. "(JSON)" values take a
# JSON literal, e.g. AUOREO_CORS_ORIGINS='["https://app.example.com"]'. Nested groups such as
# AUOREO_LIVEKIT take a JSON object; settings.json is the friendlier place for those.
#
# Keys can live in the encrypted store instead of a file:  auoreo secrets set ANTHROPIC_API_KEY
# Lookup order for a key: real environment → keyring/secrets.db → `.env` values.

# --------------------------------------------------------------------------------- models
# Universal rule: set the key for your provider, then name the model as  <provider>/<model id>
# The provider prefix picks the key (LiteLLM naming); everything after the first `/` is the
# provider's own model id. Examples:
#
#   key                          AUOREO_MODEL
#   OPENROUTER_API_KEY=...       openrouter/anthropic/claude-sonnet-4.5   (any OpenRouter id)
#   ANTHROPIC_API_KEY=...        anthropic/claude-sonnet-5
#   OPENAI_API_KEY=...           openai/gpt-5
#   GEMINI_API_KEY=...           gemini/gemini-2.5-pro
#   GROQ_API_KEY=...             groq/llama-3.3-70b-versatile
#   XAI_API_KEY=...              xai/grok-4
#   MISTRAL_API_KEY=...          mistral/mistral-large-latest
#   DEEPSEEK_API_KEY=...         deepseek/deepseek-chat
#   TOGETHERAI_API_KEY=...       together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo
#   FIREWORKS_AI_API_KEY=...     fireworks_ai/accounts/fireworks/models/<model>
#   COHERE_API_KEY=...           cohere/command-r-plus
#   (no key)                     ollama/llama3.2            (OLLAMA_API_BASE=http://localhost:11434)
#   AZURE_API_KEY + AZURE_API_BASE + AZURE_API_VERSION     azure/<deployment name>
#
# Aliases: `best`, `sonnet`, `opus`, `sonnet[1m]` / `opus[1m]` (1M-context deployments).
# `auoreo doctor` prints one credentials row per configured model and names any missing key.
# main model, <provider>/<model id> · default unset
AUOREO_MODEL=openrouter/anthropic/claude-sonnet-4.5
# cheaper model for titles / compaction / guardian; unset = AUOREO_MODEL · default unset
AUOREO_SMALL_MODEL=
# embedding model for long-term memory; unset = keyword search only · default unset
AUOREO_EMBED_MODEL=
# embedding dimensions (only for models that let you choose) · default unset
AUOREO_EMBED_DIMS=
# named model groups, e.g. {"default":{"deployments":[{"model":"anthropic/claude-sonnet-5"}]}}
# default built-in (see settings.json) (JSON)  [home]
AUOREO_MODELS=
# extra model aliases, e.g. {"fast":"groq/llama-3.3-70b-versatile"} · default {} (JSON)  [home]
AUOREO_ALIASES=
# per-group fallback chains, e.g. {"default":["openai/gpt-5"]}
# default {"default": ["small"]} (JSON)  [home]
AUOREO_FALLBACKS=
# per-session spend cap in USD (sub-agents count toward the root) · default unset  [home]
AUOREO_MAX_COST_USD=
# aux model routing per background task (title, compaction, guardian, …)
# JSON object; settings.json key `auxiliary`  [home]
AUOREO_AUXILIARY=
# retries / timeouts / cooldowns of the LiteLLM Router
# JSON object; settings.json key `gateway_tuning`  [home]
AUOREO_GATEWAY_TUNING=
# gateway extras: key pools, daily budgets, structured output, OpenRouter lane, deployments
# JSON object; settings.json key `i2`  [home]
AUOREO_I2=
# opt-in model/effort bandit policy (off by default)
# JSON object; settings.json key `bandit`  [home]
AUOREO_BANDIT=

# ------------------------------------------ provider keys (fill in only the ones you use)
# OpenRouter — openrouter/<vendor>/<model>
OPENROUTER_API_KEY=
# Anthropic — anthropic/<model>
ANTHROPIC_API_KEY=
# OpenAI — openai/<model>; also OpenAI STT/TTS/Realtime and image generation
OPENAI_API_KEY=
# Google Gemini — gemini/<model>
GEMINI_API_KEY=
# Groq — groq/<model>; also Groq STT
GROQ_API_KEY=
# xAI — xai/<model>; also xAI STT (experimental)
XAI_API_KEY=
# Mistral — mistral/<model>; also Mistral STT/TTS
MISTRAL_API_KEY=
# DeepSeek — deepseek/<model>
DEEPSEEK_API_KEY=
# Together AI — together_ai/<model>
TOGETHERAI_API_KEY=
# Fireworks AI — fireworks_ai/<model>
FIREWORKS_AI_API_KEY=
# Cohere — cohere/<model>; also the `cohere` memory rerank backend
COHERE_API_KEY=
# Azure OpenAI — azure/<deployment> (with AZURE_API_BASE + AZURE_API_VERSION)
AZURE_API_KEY=
# Azure OpenAI API version, e.g. 2025-04-01-preview
AZURE_API_VERSION=
# Azure OpenAI endpoint, https://<resource>.openai.azure.com  [home]
AZURE_API_BASE=
# Ollama server for ollama/<model> (default http://localhost:11434)  [home]
OLLAMA_API_BASE=

# ------------------------------- tool and backend keys (only for the features you enable)
# web_search: Exa provider
EXA_API_KEY=
# web_search: Parallel provider
PARALLEL_API_KEY=
# web_search: Brave provider
BRAVE_API_KEY=
# web_search: Tavily provider
TAVILY_API_KEY=
# web_search / web_fetch: Jina search + reader
JINA_API_KEY=
# web_search / web_fetch: Firecrawl provider
FIRECRAWL_API_KEY=
# gh_* tools: GitHub token (or run `gh auth login` once)
GH_TOKEN=
# gh_* tools: alternative name for the GitHub token
GITHUB_TOKEN=
# voice: Deepgram streaming STT
DEEPGRAM_API_KEY=
# voice: DeepInfra STT
DEEPINFRA_API_KEY=
# voice: ElevenLabs STT/TTS
ELEVENLABS_API_KEY=
# voice: Porcupine wake word (PORCUPINE_ACCESS_KEY also accepted)
PICOVOICE_ACCESS_KEY=
# voice: Hugging Face token for the pyannote diarization models
HF_TOKEN=
# imagegen plugin: fal.ai FLUX provider
FAL_KEY=
# execution environment: E2B sandboxes
E2B_API_KEY=
# execution environment: Modal token id
MODAL_TOKEN_ID=
# execution environment: Modal token secret
MODAL_TOKEN_SECRET=
# execution environment: Daytona sandboxes
DAYTONA_API_KEY=
# LiveKit SFU / SIP / agent worker (server URL goes in AUOREO_LIVEKIT)
LIVEKIT_API_KEY=
# LiveKit API secret
LIVEKIT_API_SECRET=
# mqtt plugin: broker password (name configurable via password_secret)
MQTT_PASSWORD=
# Passed through to the `gh` CLI behind the gh_* tools (standard names; usually unset):
# GitHub Enterprise host for gh_* tools, e.g. github.example.com  [home]
GH_HOST=
# alternative gh config directory
GH_CONFIG_DIR=
# outbound proxy for the gh CLI  [home]
HTTPS_PROXY=
# hosts that bypass HTTPS_PROXY  [home]
NO_PROXY=
# CA bundle for the gh CLI  [home]
SSL_CERT_FILE=
# Secrets with a `/` in the name cannot be environment variables; store them with
#   auoreo secrets set <name>
#   telegram/bot_token          Telegram connector + delivery
#   discord/bot_token           Discord gateway connector (inbound, approvals)
#   discord/webhook_url         Discord delivery via webhook
#   email/password              email plugin (IMAP/SMTP password; or use `auoreo login google`)
#   calendar/password           calendar plugin (CalDAV)
#   oauth/google_client_secret  Google OAuth client secret (connectors/google/oauth.yaml)
#   webhook/<route>             HMAC secret of webhooks/<route>.yaml (`auoreo webhook add` makes one)
#   provider/<name>/<slot>      extra keys for a provider key pool (i2.key_pools)

# --------------------------------------------------------------------------------- server
# litellm (real models) | fake (deterministic, keyless) · default litellm
AUOREO_GATEWAY=litellm
# bind address; anything beyond loopback needs AUOREO_SERVER_PASSWORD · default 127.0.0.1  [home]
AUOREO_HOST=
# HTTP + WebSocket port · default 4096
AUOREO_PORT=4096
# required for non-loopback binds; browsers get a short-lived JWT cookie · default unset  [home]
AUOREO_SERVER_PASSWORD=
# agent that answers when none is named · default default
AUOREO_AGENT=default
# workflow used for plain chat turns · default chat
AUOREO_WORKFLOW=chat
# extra allowed browser origins · default [] (JSON)  [home]
AUOREO_CORS_ORIGINS=
# WebSocket keepalive ping · default 20.0  [home]
AUOREO_WS_PING_INTERVAL_S=
# name shown to bridged instances · default auoreo  [home]
AUOREO_INSTANCE_NAME=
# UI / prompt locale, e.g. en-US · default unset  [home]
AUOREO_LOCALE=
# uvicorn workers; >1 requires AUOREO_REDIS_URL · default 1  [home]
AUOREO_WORKERS=
# Redis for multi-worker event fan-out, redis://host:6379/0 · default unset  [home]
AUOREO_REDIS_URL=
# serve AUOREO itself as an MCP server at /mcp · default true  [home]
AUOREO_MCP_SERVER_ENABLED=
# Host allowlist, trusted proxies, cookie + queue limits
# JSON object; settings.json key `http`  [env-only]
AUOREO_HTTP=
# serve flags: ws, tunnel, trusted hosts, mDNS, ws_auth (token|jwt|capability|off)
# JSON object; settings.json key `cli`  [home]
AUOREO_CLI=
# loop / heartbeat / worktree gc / debug upload endpoint
# JSON object; settings.json key `cli2`  [home]
AUOREO_CLI2=
# JWT session cookies, capability tokens, keyring policy on public binds
# JSON object; settings.json key `h1b`  [home]
AUOREO_H1B=
# web UI/CLI extras: share links, skills hub UI, doctor --fix, stream-json guard
# JSON object; settings.json key `i5`  [home]
AUOREO_I5=
# custom variables from Settings → Environment (secret values live in secrets.db)
# JSON object; settings.json key `env`  [home]
AUOREO_ENV=

# ------------------------------------------------------- security (real environment only)
# These are frozen from the real process environment at startup so prompt-injected repos can't
# loosen them. Set them with `export` (or your service manager), never in a .env file.
# manual | smart | yolo | plan | acceptEdits (yolo also needs AUOREO_YOLO=1)
# default manual  [env-only]
AUOREO_PERMISSION_MODE=
# set to 1 to allow permission_mode=yolo (floors still apply)  [env-only]
AUOREO_YOLO=
# smart mode: guardian review budget in seconds (else i9.guardian.timeout_s, 15)
# default unset  [env-only]
AUOREO_SMART_TIMEOUT=
# approvals.smart_policy: there is no separate knob — the guardian policy text is the
# `prompts/guardian.md` section (role: guardian); override it in ~/.auoreo/prompts/ and keep
# approvals.unattended (approve|deny per single_query/cron/platform) for no-human runs.
# unattended approval policy per run kind: single_query / cron / platform
# JSON object; settings.json key `approvals`  [env-only]
AUOREO_APPROVALS=
# how long an approval card waits for you · default 300.0  [env-only]
AUOREO_APPROVAL_TIMEOUT_S=
# redaction modes, sensitive writes, sandbox Landlock layer, trust settings
# JSON object; settings.json key `security`  [env-only]
AUOREO_SECURITY=
# hardline-floor knobs (oversized inline command threshold, …)
# JSON object; settings.json key `floors`  [env-only]
AUOREO_FLOORS=
# mask secrets in logs, events and tool output · default true  [env-only]
AUOREO_REDACT_SECRETS=
# set to 1 to also mask phone numbers  [env-only]
AUOREO_REDACT_PHONES=
# require | allow-file | forbid-file — where the secrets-encryption key may live
# default allow-file  [env-only]
AUOREO_KEYRING=
# backend per kind, e.g. {"sandbox":"bwrap","stt":"openai"}; sandbox default auto
# default {} (JSON)  [env-only]
AUOREO_BACKENDS=
# warn | fail when the selected sandbox cannot start · default warn  [env-only]
AUOREO_SANDBOX_POLICY=
# image for the docker sandbox backend · default python:3.12-slim  [env-only]
AUOREO_SANDBOX_DOCKER_IMAGE=
# memory limit for the docker sandbox backend · default 1g  [env-only]
AUOREO_SANDBOX_DOCKER_MEM_LIMIT=
# let web tools reach private / loopback addresses (SSRF floor off) · default false  [env-only]
AUOREO_ALLOW_PRIVATE_URLS=
# webhook ingress: strict_secrets (default true), size limits
# JSON object; settings.json key `webhooks`  [env-only]
AUOREO_WEBHOOKS=
# extra definition roots (agents/tools/skills …) after the bundled one
# default [] (JSON)  [env-only]
AUOREO_EXTRA_ROOTS=
# runtime home, default ~/.auoreo (Windows %LOCALAPPDATA%\auoreo)  [env-only]
AUOREO_HOME=
# profile name: uses <home>/profiles/<name>/ (same as --profile)  [env-only]
AUOREO_PROFILE=

# ----------------------------------------------------------- database and secrets at rest
# off | columns | sqlcipher · default off  [home]
AUOREO_DB_ENCRYPTION=
# named DSNs for the db_query tool, values as secret refs: {"prod":"secret:prod_dsn"}
# default {} (JSON)  [home]
AUOREO_DB_QUERY_DSNS=

# ----------------------------------------------------------- sessions, compaction, memory
# agent-loop limits (steps, budgets, doom-loop guards)
# JSON object; settings.json key `loop`  [home]
AUOREO_LOOP=
# compaction thresholds, idle compaction, memory nudges, query rewrite
# JSON object; settings.json key `compaction`  [home]
AUOREO_COMPACTION=
# compaction extras, memory scopes/tenants/decay, re-embed, CJK search
# JSON object; settings.json key `i4`  [home]
AUOREO_I4=
# long-term memory: embed model, recall, HyDE, graph, chunking
# JSON object; settings.json key `memory`  [home]
AUOREO_MEMORY=
# local cross-encoder for memory rerank (backends.rerank)
# default cross-encoder/ms-marco-MiniLM-L6-v2  [home]
AUOREO_RERANK_MODEL=
# allow downloading rerank weights · default false  [home]
AUOREO_RERANK_DOWNLOAD_MODELS=
# default 2.0  [home]
AUOREO_RERANK_TIMEOUT_S=
# default 8  [home]
AUOREO_RERANK_TOP_N=
# fail (not warn) when a user overlay shadows a bundled definition · default false  [home]
AUOREO_STRICT_OVERLAYS=
# exit_plan_mode requires a verify_plan PASS first · default false  [home]
AUOREO_PLAN_REQUIRES_VERIFY=
# consent-first proactive suggestions · default true  [home]
AUOREO_SUGGESTIONS_ENABLED=
# delivery target for suggestions (backends/delivery/<name>) · default log  [home]
AUOREO_SUGGESTIONS_HOME=
# e.g. 22:00-07:00 · default unset  [home]
AUOREO_SUGGESTIONS_QUIET_HOURS=
# default 5  [home]
AUOREO_SUGGESTIONS_MAX_PENDING=

# -------------------------------------------------------------- tools, shell, search, LSP
# tool knobs: PTY/jobs limits, apply_patch LSP diagnostics, doc caps, pandas
# JSON object; settings.json key `tools`  [home]
AUOREO_TOOLS=
# check_fn TTL, collision policy, spill cap, MCP sampling limits
# JSON object; settings.json key `tool_engine`  [home]
AUOREO_TOOL_ENGINE=
# apply_patch formatter step, run_code / video_analyze limits, metric store
# JSON object; settings.json key `h5`  [home]
AUOREO_H5=
# egress proxy (allow/deny hosts), search provider order + cache, guardian timeout
# JSON object; settings.json key `i9`  [home]
AUOREO_I9=
# self-hosted SearXNG for web_search, http://localhost:8888 · default unset  [home]
AUOREO_SEARXNG_URL=
# concurrent persistent shells per session · default 8  [home]
AUOREO_SHELL_MAX_PROCESSES=
# default 5000  [home]
AUOREO_LSP_TIMEOUT_MS=
# language-server commands, e.g. {"python":["uvx","ty","server"]} · default {} (JSON)  [home]
AUOREO_LSP_SERVERS=
# Chromium/Chrome binary for the browser backend · default unset  [home]
AUOREO_BROWSER_EXECUTABLE_PATH=
# repos the gh_* tools may touch, e.g. ["owner/repo"] · default [] (JSON)  [home]
AUOREO_GITHUB_ALLOWED_REPOS=

# -------------------------------------------------------- automation, teams, plugins, MCP
# default true  [home]
AUOREO_HOOKS_ENABLED=
# run jobs/*.yaml on their schedules · default true  [home]
AUOREO_SCHEDULER_ENABLED=
# accept POST /hooks/<route> · default true  [env-only]
AUOREO_WEBHOOKS_ENABLED=
# default 1  [home]
AUOREO_AUTOMATION_WORKERS=
# default 2.0  [home]
AUOREO_AUTOMATION_START_DELAY_S=
# default 2.0  [home]
AUOREO_AUTOMATION_POLL_S=
# default 900  [home]
AUOREO_AUTOMATION_RUN_TIMEOUT_S=
# delegation depth limit · default 2  [home]
AUOREO_TEAMS_MAX_DEPTH=
# concurrent children per parent · default 3  [home]
AUOREO_TEAMS_MAX_CHILDREN=
# default 900  [home]
AUOREO_TEAMS_CHILD_TIMEOUT_S=
# opt-in supervisor that can spawn at depth 2 · default false  [home]
AUOREO_TEAMS_ORCHESTRATOR_ENABLED=
# delegation pause, heartbeat/stale timings, job timeout, chat approvals
# JSON object; settings.json key `teams2`  [home]
AUOREO_TEAMS2=
# kanban dispatcher (off by default), cron extras, delegation naming
# JSON object; settings.json key `i3`  [home]
AUOREO_I3=
# default true  [home]
AUOREO_PLUGINS_ENABLED=
# per-plugin config, e.g. {"telegram":{"enabled":true,"owners":["123"]}} · default {} (JSON)  [home]
AUOREO_PLUGINS=
# Python for plugin venvs · default 3.12  [home]
AUOREO_PLUGINS_PYTHON=
# copy bundled plugins into ~/.auoreo/plugins on first start · default false  [home]
AUOREO_PLUGINS_SEED=
# default 30.0  [home]
AUOREO_PLUGINS_POLL_S=
# default 60.0  [home]
AUOREO_PLUGINS_TOOL_TIMEOUT_S=
# default 1.0  [home]
AUOREO_PLUGINS_BACKOFF_SCALE=
# plugin trust tiers/taps/allow-list, MCP roots + sampling, GitHub /meta CIDRs
# JSON object; settings.json key `i6`  [home]
AUOREO_I6=
# voice extras, PREFS proposals, skills hub taps, review worktrees
# JSON object; settings.json key `g6`  [home]
AUOREO_G6=

