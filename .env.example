# AUOREO — copy to `.env` (project) or `~/.auoreo/.env`. Loaded at startup; a variable that
# is already set in the real environment always wins, and blank values are ignored.
# A PROJECT .env is repository-controlled and allowlisted: it may set provider keys
# (*_API_KEY, *_TOKEN, …) and AUOREO_MODEL / AUOREO_SMALL_MODEL / AUOREO_EMBED_MODEL /
# AUOREO_EMBED_DIMS / AUOREO_AGENT / AUOREO_WORKFLOW / AUOREO_GATEWAY / AUOREO_PORT only.
# Everything else marked [home] below (and *_API_BASE / *_URL / *_HOST / proxies) is ignored
# there with a warning: put it in ~/.auoreo/.env or the real environment.
# Keys can also live in the encrypted store instead:  auoreo secrets set ANTHROPIC_API_KEY

# ----------------------------------------------------------------------------- models
# Universal rule: set the key for your provider, then name the model as
#     <provider>/<model id>
# The provider prefix picks the key (LiteLLM naming), everything after the first `/` is the
# provider's own model id. Examples:
#
#   key in .env                 AUOREO_MODEL
#   OPENROUTER_API_KEY=...      openrouter/anthropic/claude-sonnet-4.5   (any OpenRouter id)
#   ANTHROPIC_API_KEY=...       anthropic/claude-sonnet-5
#   OPENAI_API_KEY=...          openai/gpt-5
#   GEMINI_API_KEY=...          gemini/gemini-2.5-pro
#   GROQ_API_KEY=...            groq/llama-3.3-70b-versatile
#   XAI_API_KEY=...             xai/grok-4
#   MISTRAL_API_KEY=...         mistral/mistral-large-latest
#   DEEPSEEK_API_KEY=...        deepseek/deepseek-chat
#   TOGETHERAI_API_KEY=...      together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo
#   FIREWORKS_AI_API_KEY=...    fireworks_ai/accounts/fireworks/models/<model>
#   (no key)                    ollama/llama3.2            (OLLAMA_API_BASE=http://localhost:11434 [home])
#   AZURE_API_KEY + AZURE_API_BASE [home] + AZURE_API_VERSION   azure/<deployment name>
#
# `auoreo doctor` prints one credentials row per configured model and names any missing key.
AUOREO_MODEL=openrouter/anthropic/claude-sonnet-4.5
# Optional cheaper model for titles / compaction / guardian (same <provider>/<id> form).
# Unset = reuse AUOREO_MODEL.
AUOREO_SMALL_MODEL=
# Optional embedding model for long-term memory (unset = settings.json memory.embed_model).
# Memory falls back to keyword search when embeddings are unavailable.
AUOREO_EMBED_MODEL=
AUOREO_EMBED_DIMS=

# Provider keys: fill in only the ones you use.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ----------------------------------------------------------------------------- server
# [home] AUOREO_HOST, AUOREO_SERVER_PASSWORD, AUOREO_CORS_ORIGINS, AUOREO_MODELS, AUOREO_SEARXNG_URL
AUOREO_HOST=127.0.0.1
AUOREO_PORT=4096
# Required when binding beyond loopback.  [home]
AUOREO_SERVER_PASSWORD=
# litellm (real models) | fake (deterministic, keyless)
AUOREO_GATEWAY=litellm
AUOREO_AGENT=default
AUOREO_WORKFLOW=chat
# Security knobs are read ONLY from the real process environment: a .env file may not set
# AUOREO_YOLO, AUOREO_PERMISSION_MODE, AUOREO_SANDBOX*, AUOREO_BACKENDS, AUOREO_REDACT_*,
# AUOREO_SECURITY, AUOREO_APPROVALS, AUOREO_WEBHOOKS, AUOREO_KEYRING, … (ignored with a warning).
# manual | smart | yolo | plan | acceptEdits   (yolo also needs AUOREO_YOLO=1 at startup)
# AUOREO_PERMISSION_MODE=manual
# Smart mode (permission_mode=smart): one cheap aux "guardian" call reviews each `ask`
# (APPROVE / DENY / ESCALATE to you). Its budget in seconds (default 15; i9.guardian.timeout_s
# in settings.json); a timeout always escalates to the human.  [home]
# AUOREO_SMART_TIMEOUT=15
# approvals.smart_policy: there is no separate knob — the guardian policy text is the
# `prompts/guardian.md` section (role: guardian); override it in ~/.auoreo/prompts/ and keep
# approvals.unattended (approve|deny per single_query/cron/unattended-platform) for no-human runs.
# AUOREO_YOLO=
# require | allow-file | forbid-file  (where the secrets-encryption key may live)
# AUOREO_KEYRING=allow-file
# Runtime home (default ~/.auoreo; Windows %LOCALAPPDATA%\auoreo). Ignored in .env files
# (it would select another settings.json): export it in the real environment instead.
# AUOREO_HOME=
