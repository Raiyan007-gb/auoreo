# AUOREO — copy to .env for local overrides. Real secrets belong in the encrypted store:
#   auoreo secrets set OPENROUTER_API_KEY
# Values below are placeholders.

AUOREO_HOST=127.0.0.1
AUOREO_PORT=4096
# Required when binding beyond loopback.
AUOREO_SERVER_PASSWORD=
# litellm (real models) | fake (deterministic, keyless)
AUOREO_GATEWAY=litellm
# Model or routing group (default, small, ...). Empty = settings.json models.default.
AUOREO_MODEL=
AUOREO_AGENT=default
AUOREO_WORKFLOW=chat
# manual | smart | yolo | plan | acceptEdits   (yolo also needs AUOREO_YOLO=1 at startup)
AUOREO_PERMISSION_MODE=manual
AUOREO_YOLO=
# require | allow-file | forbid-file  (where the secrets-encryption key may live)
AUOREO_KEYRING=allow-file
# Runtime home (default ~/.auoreo; Windows %LOCALAPPDATA%\auoreo)
AUOREO_HOME=

# Provider credentials (prefer `auoreo secrets set` over env)
OPENROUTER_API_KEY=
